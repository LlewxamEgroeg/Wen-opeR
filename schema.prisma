// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  OWNER
  LEAD
  CONTRIBUTOR
  REVIEWER
  OBSERVER
}

enum InitiativeStatus {
  PLANNING
  ACTIVE
  AT_RISK
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum InitiativeRole {
  OWNER
  LEAD
  MEMBER
  OBSERVER
}

enum MilestoneStatus {
  PLANNING
  ACTIVE
  AT_RISK
  COMPLETED
  CANCELLED
}

enum DeliverableStatus {
  DRAFT
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  REJECTED
  BLOCKED
  DONE
  CANCELLED
}

enum DeliverableType {
  DOCUMENT
  CODE
  DESIGN
  TEST_PLAN
  DEPLOYMENT
  OTHER
}

enum DependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  PR_LINK
  FIGMA_LINK
  DOCUMENT_LINK
  TEST_REPORT
  DEPLOYMENT_LOG
  SCREENSHOT
  VIDEO
  FILE_UPLOAD
  OTHER
}

enum ActivityType {
  INITIATIVE_CREATED
  INITIATIVE_STATUS_CHANGED
  MILESTONE_CREATED
  MILESTONE_STATUS_CHANGED
  DELIVERABLE_CREATED
  DELIVERABLE_STATUS_CHANGED
  DELIVERABLE_ASSIGNED
  DELIVERABLE_REVIEW_REQUESTED
  DELIVERABLE_APPROVED
  DELIVERABLE_REJECTED
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  COMMENT_ADDED
  EVIDENCE_ADDED
  DEPENDENCY_ADDED
  RISK_FLAGGED
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  role          Role      @default(CONTRIBUTOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hashedPassword String?
  identities    Json?

  ownedInitiatives  Initiative[]   @relation("InitiativeOwner")
  ledMilestones     Milestone[]    @relation("MilestoneLead")
  assignedTasks     Task[]         @relation("TaskAssignee")
  reviewTasks       Task[]         @relation("TaskReviewer")
  comments          Comment[]
  evidence          Evidence[]
  activities        Activity[]
  preferences       UserPreferences?
  initiativeMemberships InitiativeMember[]
}

model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  timezone  String   @default("UTC")
  notifyOn  Json
  theme     String   @default("system")
}

model Initiative {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @db.Text
  status      InitiativeStatus @default(PLANNING)
  ownerId     String
  owner       User     @relation("InitiativeOwner", fields: [ownerId], references: [id])
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones  Milestone[]
  members     InitiativeMember[]
  activities  Activity[]
}

model InitiativeMember {
  id            String           @id @default(cuid())
  initiativeId  String
  initiative    Initiative       @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          InitiativeRole   @default(MEMBER)
  joinedAt      DateTime         @default(now())

  @@unique([initiativeId, userId])
}

model Milestone {
  id            String           @id @default(cuid())
  key           String
  initiativeId  String
  initiative    Initiative       @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name          String
  description   String?          @db.Text
  status        MilestoneStatus  @default(PLANNING)
  leadId        String?
  lead          User?            @relation("MilestoneLead", fields: [leadId], references: [id])
  targetDate    DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  deliverables  Deliverable[]
  activities    Activity[]

  @@unique([initiativeId, key])
}

model Deliverable {
  id            String             @id @default(cuid())
  key           String
  milestoneId   String
  milestone     Milestone          @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  name          String
  description   String             @db.Text
  acceptance    String             @db.Text
  status        DeliverableStatus  @default(DRAFT)
  type          DeliverableType    @default(DOCUMENT)
  ownerId       String
  owner         User               @relation("DeliverableOwner", fields: [ownerId], references: [id])
  reviewerId    String?
  reviewer      User?              @relation("DeliverableReviewer", fields: [reviewerId], references: [id])
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tasks         Task[]
  evidence      Evidence[]
  comments      Comment[]
  dependencies  DeliverableDependency[] @relation("Dependent")
  dependents    DeliverableDependency[] @relation("Dependency")
  activities    Activity[]

  @@unique([milestoneId, key])
}

model DeliverableDependency {
  id             String       @id @default(cuid())
  dependentId    String
  dependent      Deliverable  @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)
  dependencyId   String
  dependency     Deliverable  @relation("Dependency", fields: [dependencyId], references: [id], onDelete: Cascade)
  type           DependencyType @default(BLOCKS)

  @@unique([dependentId, dependencyId])
}

model Task {
  id            String       @id @default(cuid())
  key           String
  deliverableId String
  deliverable   Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  name          String
  description   String?      @db.Text
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reviewerId    String?
  reviewer      User?        @relation("TaskReviewer", fields: [reviewerId], references: [id])
  dueDate       DateTime?
  completedAt   DateTime?
  estimatedHours Float?
  actualHours   Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  comments      Comment[]
  evidence      Evidence[]
  activities    Activity[]

  @@unique([deliverableId, key])
}

model Evidence {
  id            String        @id @default(cuid())
  deliverableId String?
  deliverable   Deliverable?  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          EvidenceType
  title         String
  description   String?       @db.Text
  url           String?
  fileKey       String?
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime      @default(now())
}

model Comment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content       String    @db.Text
  parentId      String?
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Activity {
  id             String        @id @default(cuid())
  initiativeId   String?
  initiative     Initiative?   @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  milestoneId    String?
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  deliverableId  String?
  deliverable    Deliverable?  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           ActivityType
  description    String        @db.Text
  metadata       Json?
  createdAt      DateTime      @default(now())
}